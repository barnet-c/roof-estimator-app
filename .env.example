# Anthropic API key for AI roof vision analysis.
# Without it, the backend falls back to a deterministic mock analyzer
# so the app stays fully runnable offline.
ANTHROPIC_API_KEY=

# Claude model used for roof vision analysis (default: claude-opus-5).
ROOF_MODEL=claude-opus-5

# --- AI "after" image generation (optional) ---
# If set, the before/after panel's "after" image is created by EDITING the
# customer's own photo with a real image model (OpenAI gpt-image-1) — repairing
# the roof while keeping the same building, angle, colors and lighting. This key
# is required to actually reconstruct a repaired roof. Without it, a deterministic
# offline preview is used (it only cleans/brightens the photo, it cannot rebuild
# the roof) so the app stays fully runnable with no keys.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# Backend port.
PORT=8787

# Secret used to sign auth tokens (HMAC). Change this for anything real.
APP_SECRET=dev-secret-change-me

# --- Email ---
# Choose how outgoing emails (customer estimates, new-lead alerts) are sent.
# The app runs fine with no email setup at all — it just logs instead.
#
#   EMAIL_PROVIDER = console | smtp | resend
#     console : write the email to the server log, do not deliver (default when
#               no credentials are set — great for local dev/testing)
#     smtp    : send via any SMTP server, including Gmail
#     resend  : send via the Resend HTTP API (needs a verified sending domain)
#   Leave EMAIL_PROVIDER blank to auto-detect from whichever creds are present.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_FROM_NAME=Roof Estimator
# Optional extra recipients:
EMAIL_CC=
EMAIL_REPLY_TO=

# SMTP (e.g. Gmail). For Gmail, SMTP_PASS must be a 16-char App Password
# (https://myaccount.google.com/apppasswords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Resend (alternative to SMTP). Requires a verified domain; you cannot send
# "from" a plain @gmail.com address with Resend.
RESEND_API_KEY=
